# Production site URL used for canonical links, sitemap.xml, robots.txt,
# Open Graph / Twitter image URLs, and JSON-LD structured data.
# Set this to the real, live domain before deploying to production —
# do not leave it unset and do not use localhost.
NEXT_PUBLIC_SITE_URL=https://lankaivorydestination.com

# Contact form (app/api/contact) — sends enquiry emails via Resend (resend.com).
# Create a free Resend account, generate an API key, and set it here / in Vercel.
# Never commit the real key — this file only documents the variable name.
RESEND_API_KEY=

# Where enquiry emails should be delivered. Update once the client confirms
# their preferred inbox — defaults to the address used elsewhere on the site.
CONTACT_TO_EMAIL=hello@lankaivorydestinations.com

# Sender shown on enquiry emails. Resend's shared onboarding@resend.dev address
# works immediately without domain verification. Once lankaivorydestination.com
# is verified in Resend, switch this to a branded address, e.g.
# "Lanka Ivory Destinations <enquiries@lankaivorydestination.com>"
CONTACT_FROM_EMAIL=Lanka Ivory Destinations <onboarding@resend.dev>
